# Cloudflare response headers (copied into dist/ by the build).
#
# Everything Astro emits into /_astro/ carries a content hash in its filename,
# so a new build produces a new name. Those files can never go stale and are
# safe to cache permanently — which matters here, where the gallery is ~850
# images.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable
