---
/**
 * REVOLT LC — REGISTRATION
 *
 * ⚠ SCAFFOLD. Two things here are deliberately placeholders, both flagged
 *   inline and both one-line edits:
 *
 *   1. FIELDS — the real field list hasn't been supplied yet. What's below is
 *      a standard youth-sports registration set (player, guardian, school,
 *      sizing, medical, agreement) so the page can be laid out and judged.
 *      Add / cut / reorder freely — every field is plain markup.
 *
 *   2. VENMO + FEES — see the VENMO and FEES constants directly below. No
 *      handle and no price were supplied, so neither is invented here; the
 *      payment panel renders a visible "not set" state until they're filled.
 *
 * The program selector is NOT a placeholder: it's generated from
 * data/programs.ts, so it can never drift from the programs on the home page.
 *
 * Submissions go to Web3Forms, which emails them to the address the access
 * key is registered to. The key is a public form identifier, not a secret —
 * it ships in the page source by design. Swap ENDPOINT and ACCESS_KEY together
 * to move providers.
 */
import Layout from '../layouts/Layout.astro';
import { programs, seasons, citiesFor, totalTournaments, allStates } from '../data/programs';

const ENDPOINT = 'https://api.web3forms.com/submit';
const ACCESS_KEY = '6f6ec3c0-1257-4c7d-a2ad-bcd951c2caf3';

/** ⚠ SET THIS — the club's Venmo username, without the leading @. */
const VENMO = '';

/**
 * ⚠ SET THESE — program fees, keyed by program id.
 * Pricing is listed as NOT SUPPLIED in data/programs.ts, so nothing is
 * guessed here. A null renders as "TBD" and the payment panel says so out
 * loud rather than showing a made-up number.
 */
const FEES: Record<string, number | null> = {
  'box-travel': null,
  'summer-travel': null,
};

/**
 * ⚠ SET THIS — the all-in price for running both rosters, and the id the
 * bundle is submitted under. The saving is DERIVED (separate total minus
 * this), never typed in, so the card can't advertise a discount the two
 * prices above don't actually add up to.
 */
const BUNDLE_ID = 'both';
const BUNDLE_PRICE: number | null = null;

const money = (n: number | null) =>
  n === null ? 'TBD' : `$${n.toLocaleString('en-US')}`;

/** What the two rosters cost bought separately — null until every fee is set. */
const fees = programs.map((p) => FEES[p.id] ?? null);
const separateTotal = fees.every((f): f is number => f !== null)
  ? fees.reduce((a, b) => a + b, 0)
  : null;

/** Only a real, positive saving is ever shown as a number. */
const savings =
  separateTotal !== null && BUNDLE_PRICE !== null && separateTotal > BUNDLE_PRICE
    ? separateTotal - BUNDLE_PRICE
    : null;

const gradYears = ['2027', '2028', '2029', '2030', '2031', '2032', 'Other'];
const jerseySizes = ['YM', 'YL', 'S', 'M', 'L', 'XL', 'XXL'];
const positions = ['Attack', 'Midfield', 'Defense', 'LSM', 'FOGO', 'Goalie'];
---

<Layout
  title="Register — Revolt Lacrosse Club"
  description="Register for a Revolt LC roster. Pick your program, submit player and guardian details, and pay by Venmo."
>
  <!-- ═══ HEADER ═══════════════════════════════════════════════
       The photo is portrait, so it takes a full-height column beside
       the headline rather than sitting behind it like the home hero. -->
  <section class="reg">
    <div class="reg__glow" aria-hidden="true"></div>
    <div class="shell reg__inner">
      <div class="reg__copy">
        <div class="eyebrow">
          <span class="label">[ Registration ]</span>
          <span class="eyebrow__rule"></span>
          <span class="label label--dim">2027 season</span>
        </div>

        <h1 class="reg__title display">
          Pick a roster.<br />
          <span class="display--ghost">Fill this out.</span><br />
          <span class="display--gold">Go play.</span>
        </h1>

        <p class="lede reg__lede">
          One form for both rosters. It takes about three minutes, and payment is
          the last step — you'll send it by Venmo once the details are in.
        </p>

        <ol class="reg__steps">
          <li><b>01</b> Choose your program</li>
          <li><b>02</b> Player &amp; guardian details</li>
          <li><b>03</b> Pay by Venmo</li>
        </ol>
      </div>

      <!-- Club film. It is a three-panel split-screen edit that closes on the
           wordmark, so it keeps its full 16:9 frame — a portrait crop would
           throw away two of the three panels. The still underneath is what
           shows if a browser declines to autoplay, so no play glyph is ever
           painted over it. -->
      <figure class="reg__shot">
        <img class="reg__still" src="/reg-poster.jpg" alt="" aria-hidden="true" />

        <video
          class="reg__video"
          data-reg-video
          autoplay
          muted
          loop
          playsinline
          preload="auto"
          disablepictureinpicture
          tabindex="-1"
          aria-hidden="true"
        >
          <source src="/reg-film-480.mp4" type="video/mp4" media="(max-width: 900px)" />
          <source src="/reg-film.mp4" type="video/mp4" />
        </video>

        <div class="reg__shotScrim" aria-hidden="true"></div>
        <div class="reg__shotLines" aria-hidden="true"></div>
        <figcaption class="label label--dim">Revolt LC · Summer circuit</figcaption>
      </figure>
    </div>
  </section>

  <!-- ═══ FORM ═════════════════════════════════════════════════ -->
  <section class="section form" id="form">
    <div class="shell">
      <form class="reg__form" id="reg-form" novalidate data-endpoint={ENDPOINT}>
        <input type="hidden" name="access_key" value={ACCESS_KEY} />
        <input type="hidden" name="from_name" value="Revolt LC website" />
        <!-- Web3Forms' honeypot: a real person never checks a hidden box. -->
        <input type="checkbox" name="botcheck" class="hp" tabindex="-1" autocomplete="off" aria-hidden="true" />

        <!-- ── 001 · PROGRAM ──────────────────────────────────
             Generated from data/programs.ts. Add a program there and
             a card appears here; nothing on this page needs touching. -->
        <fieldset class="block">
          <legend class="sr-only">Choose your program</legend>
          <div class="eyebrow eyebrow--tight">
            <span class="label">[ 001 ]</span>
            <span class="eyebrow__rule"></span>
          </div>
          <h2 class="block__title display">Choose your program</h2>

          <div class="picks">
            {programs.map((p) => (
              <label class="pick">
                <input type="radio" name="program" value={p.id} data-label={p.name} required />
                <span class="pick__body">
                  <span class="pick__top">
                    <span class="pick__index label">{p.index}</span>
                    <span class="pick__season label" style={`color:${seasons[p.season].color}`}>
                      {seasons[p.season].label}
                    </span>
                    <span class="pick__mark" aria-hidden="true"></span>
                  </span>

                  <span class="pick__name display">{p.name}</span>

                  <span class="pick__specs">
                    <span><b>{p.window}</b></span>
                    <span>{p.format}</span>
                    <span>
                      {String(p.tournaments.length).padStart(2, '0')} tournaments · {citiesFor(p)}
                    </span>
                  </span>

                  <span class="pick__fee">
                    <span class="label label--dim">Program fee</span>
                    <b>{money(FEES[p.id] ?? null)}</b>
                  </span>
                </span>
              </label>
            ))}
          </div>

          <!-- ── BUNDLE ──────────────────────────────────────────
               Third option in the same radio group, so picking it
               deselects the singles. Everything numeric is derived:
               the sum, the saving, and the per-roster breakdown. -->
          <label class="bundle">
            <input type="radio" name="program" value={BUNDLE_ID} data-label="Both rosters (bundle)" />
            <span class="bundle__body">
              <span class="bundle__flag label">
                {savings !== null ? `Save ${money(savings)}` : 'Best value'}
              </span>

              <span class="bundle__main">
                <span class="bundle__top">
                  <span class="label bundle__kicker">Both rosters</span>
                  <span class="bundle__mark" aria-hidden="true"></span>
                </span>

                <span class="bundle__name display">
                  Run the <span class="display--gold">whole year.</span>
                </span>

                <span class="bundle__blurb">
                  Box in January, field through the summer — one registration, one
                  price. {totalTournaments} tournaments across {allStates}, with the
                  same roster and the same coaches from winter through July.
                </span>

                <span class="bundle__chain">
                  {programs.map((p, i) => (
                    <>
                      {i > 0 && <span class="bundle__plus" aria-hidden="true">+</span>}
                      <span class="bundle__chip">
                        <b>{p.name}</b>
                        <span>{p.window}</span>
                      </span>
                    </>
                  ))}
                </span>
              </span>

              <span class="bundle__price">
                <span class="bundle__priceRow">
                  <span class="label label--dim">Bought separately</span>
                  <s class="bundle__was">{money(separateTotal)}</s>
                </span>

                <span class="bundle__now">
                  <span class="label label--dim">Both rosters</span>
                  <b>{money(BUNDLE_PRICE)}</b>
                </span>

                {savings !== null ? (
                  <span class="bundle__save">You save {money(savings)}</span>
                ) : (
                  <span class="bundle__save bundle__save--tbd">
                    ⚠ Set <code>BUNDLE_PRICE</code> and <code>FEES</code> at the top of
                    this page and the saving calculates itself.
                  </span>
                )}
              </span>
            </span>
          </label>

          <p class="err" data-for="program" hidden>Choose a program to continue.</p>
        </fieldset>

        <!-- ── 002 · PLAYER ─────────────────────────────────── -->
        <fieldset class="block">
          <legend class="sr-only">Player</legend>
          <div class="eyebrow eyebrow--tight">
            <span class="label">[ 002 ]</span>
            <span class="eyebrow__rule"></span>
          </div>
          <h2 class="block__title display">Player</h2>

          <div class="grid">
            <div class="field">
              <label for="p-first" class="label label--dim">First name</label>
              <input id="p-first" name="playerFirst" type="text" autocomplete="given-name" required />
            </div>
            <div class="field">
              <label for="p-last" class="label label--dim">Last name</label>
              <input id="p-last" name="playerLast" type="text" autocomplete="family-name" required />
            </div>
            <div class="field">
              <label for="p-dob" class="label label--dim">Date of birth</label>
              <input id="p-dob" name="dob" type="date" />
            </div>
            <div class="field">
              <label for="p-school" class="label label--dim">High school</label>
              <input id="p-school" name="school" type="text" placeholder="Homestead High School" />
            </div>
            <div class="field">
              <label for="p-grad" class="label label--dim">Graduation year</label>
              <select id="p-grad" name="grad">
                <option value="">Select…</option>
                {gradYears.map((y) => <option value={y}>{y}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="p-pos" class="label label--dim">Primary position</label>
              <select id="p-pos" name="position">
                <option value="">Select…</option>
                {positions.map((p) => <option value={p}>{p}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="p-jersey" class="label label--dim">Jersey size</label>
              <select id="p-jersey" name="jersey">
                <option value="">Select…</option>
                {jerseySizes.map((s) => <option value={s}>{s}</option>)}
              </select>
            </div>
            <div class="field">
              <label for="p-number" class="label label--dim">Preferred number</label>
              <input id="p-number" name="number" type="text" inputmode="numeric" placeholder="20" />
            </div>
          </div>
        </fieldset>

        <!-- ── 003 · PARENT / GUARDIAN ──────────────────────── -->
        <fieldset class="block">
          <legend class="sr-only">Parent or guardian</legend>
          <div class="eyebrow eyebrow--tight">
            <span class="label">[ 003 ]</span>
            <span class="eyebrow__rule"></span>
          </div>
          <h2 class="block__title display">Parent / guardian</h2>

          <div class="grid">
            <div class="field">
              <label for="g-name" class="label label--dim">Full name</label>
              <input id="g-name" name="guardianName" type="text" autocomplete="name" required />
            </div>
            <div class="field">
              <label for="g-rel" class="label label--dim">Relationship to player</label>
              <input id="g-rel" name="guardianRelation" type="text" placeholder="Mother / Father / Guardian" />
            </div>
            <div class="field">
              <label for="g-email" class="label label--dim">Email address</label>
              <input id="g-email" name="email" type="email" autocomplete="email" required placeholder="you@example.com" />
              <p class="err" data-for="g-email" hidden>Enter a valid email address.</p>
            </div>
            <div class="field">
              <label for="g-phone" class="label label--dim">Mobile number</label>
              <input id="g-phone" name="phone" type="tel" autocomplete="tel" required placeholder="(260) 555-0142" />
              <p class="err" data-for="g-phone" hidden>Enter a phone number we can reach you on.</p>
            </div>
            <div class="field field--wide">
              <label for="g-city" class="label label--dim">City &amp; state</label>
              <input id="g-city" name="city" type="text" placeholder="Fort Wayne, IN" />
            </div>
          </div>
        </fieldset>

        <!-- ── 004 · MEDICAL & EMERGENCY ────────────────────── -->
        <fieldset class="block">
          <legend class="sr-only">Medical and emergency</legend>
          <div class="eyebrow eyebrow--tight">
            <span class="label">[ 004 ]</span>
            <span class="eyebrow__rule"></span>
          </div>
          <h2 class="block__title display">Medical &amp; emergency</h2>

          <div class="grid">
            <div class="field">
              <label for="e-name" class="label label--dim">Emergency contact</label>
              <input id="e-name" name="emergencyName" type="text" />
            </div>
            <div class="field">
              <label for="e-phone" class="label label--dim">Emergency phone</label>
              <input id="e-phone" name="emergencyPhone" type="tel" />
            </div>
            <div class="field field--wide">
              <label for="m-notes" class="label label--dim">
                Allergies, conditions or medications we should know about
              </label>
              <textarea id="m-notes" name="medical" rows="3" placeholder="Leave blank if none."></textarea>
            </div>
          </div>
        </fieldset>

        <!-- ── 005 · AGREEMENT ──────────────────────────────── -->
        <fieldset class="block">
          <legend class="sr-only">Agreement</legend>
          <div class="eyebrow eyebrow--tight">
            <span class="label">[ 005 ]</span>
            <span class="eyebrow__rule"></span>
          </div>
          <h2 class="block__title display">Agreement</h2>

          <div class="checks">
            <label class="check">
              <input type="checkbox" name="waiver" required />
              <span class="check__box" aria-hidden="true"></span>
              <span class="check__label">
                I've read and accept the participation waiver and release of liability.
                <em>(Placeholder — link the real waiver here.)</em>
              </span>
            </label>
            <label class="check">
              <input type="checkbox" name="commitment" required />
              <span class="check__box" aria-hidden="true"></span>
              <span class="check__label">
                I understand the program fee is due in full to secure the roster spot.
              </span>
            </label>
            <label class="check">
              <input type="checkbox" name="photo" />
              <span class="check__box" aria-hidden="true"></span>
              <span class="check__label">
                Revolt LC may use team photos and game film that include my player.
              </span>
            </label>
          </div>
          <p class="err" data-for="agree" hidden>Both required boxes need checking.</p>
        </fieldset>

        <div class="submit">
          <button type="submit" class="btn btn--gold">
            <span>Continue to payment</span><span class="btn__arrow">→</span>
          </button>
          <p class="label label--dim submit__fine">
            Nothing is charged here. The next step shows where to send the Venmo.
          </p>

          <p class="sendErr" id="reg-error" hidden role="alert">
            <b>That didn't send.</b> <span id="reg-error-detail"></span>
            Try again, or email
            <a class="clink" href="mailto:Mitchell.Wilkins@RevoltLC.com">Mitchell.Wilkins@RevoltLC.com</a>.
          </p>
        </div>
      </form>

      <div class="sent" id="reg-sent" hidden role="status">
        <span class="sent__mark display">✓</span>
        <p class="display sent__title">Registration received.</p>
        <p>One step left — send the program fee on Venmo below.</p>
      </div>
    </div>
  </section>

  <!-- ═══ PAYMENT ══════════════════════════════════════════════
       Always visible so a returning parent can find the handle without
       filling the form again; it just highlights once the form is sent. -->
  <section class="section pay" id="pay">
    <div class="shell">
      <div class="eyebrow reveal">
        <span class="label">[ 006 ]</span>
        <span class="eyebrow__rule"></span>
        <span class="label label--dim">Payment</span>
      </div>

      <h2 class="display pay__title reveal">
        Send it on <span class="display--gold">Venmo.</span>
      </h2>

      <div class="pay__panel reveal" id="pay-panel">
        <div class="pay__handleBox">
          <span class="label label--dim">Pay to</span>
          {VENMO ? (
            <>
              <p class="pay__handle display">@{VENMO}</p>
              <div class="pay__actions">
                <a class="btn btn--gold" href={`https://venmo.com/u/${VENMO}`} target="_blank" rel="noopener">
                  <span>Open in Venmo</span><span class="btn__arrow">↗</span>
                </a>
                <button type="button" class="btn" id="copy-handle" data-handle={`@${VENMO}`}>
                  <span>Copy handle</span>
                </button>
              </div>
            </>
          ) : (
            <>
              <p class="pay__handle pay__handle--empty display">@handle</p>
              <p class="pay__warn">
                ⚠ Venmo username not set. Add it to <code>VENMO</code> at the top of
                <code>src/pages/signup.astro</code> and this panel goes live.
              </p>
            </>
          )}
        </div>

        <ol class="pay__steps">
          <li>
            <span class="pay__n">01</span>
            <div>
              <b>Send the program fee.</b>
              <p>
                {programs.map((p) => (
                  <>
                    {p.name} — <b class="pay__amt">{money(FEES[p.id] ?? null)}</b><br />
                  </>
                ))}
                <span class="pay__bundleLine">
                  Both rosters — <b class="pay__amt">{money(BUNDLE_PRICE)}</b>
                  {savings !== null && <b class="pay__saveTag">save {money(savings)}</b>}
                </span>
              </p>
            </div>
          </li>
          <li>
            <span class="pay__n">02</span>
            <div>
              <b>Put the player's full name in the note.</b>
              <p>
                It's the only way a payment gets matched to a registration.
                Example: <span class="pay__memo">Jordan Rivera — Summer Travel</span>
              </p>
            </div>
          </li>
          <li>
            <span class="pay__n">03</span>
            <div>
              <b>Mark the payment private.</b>
              <p>Venmo posts to a public feed by default. Set it to Private before you send.</p>
            </div>
          </li>
          <li>
            <span class="pay__n">04</span>
            <div>
              <b>You'll get a confirmation email.</b>
              <p>The spot is held once the payment and the form are matched up.</p>
            </div>
          </li>
        </ol>
      </div>

      <p class="pay__help label label--dim reveal">
        Trouble with any of this? Email
        <a class="clink" href="mailto:Mitchell.Wilkins@RevoltLC.com">Mitchell.Wilkins@RevoltLC.com</a>
        and it gets sorted.
      </p>
    </div>
  </section>
</Layout>

<style>
  .sr-only {
    position: absolute;
    width: 1px; height: 1px;
    padding: 0; margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }

  /* ═══ HEADER ═══════════════════════════════════════════════ */
  .reg { position: relative; overflow: hidden; padding-block: clamp(3rem, 7vw, 6rem) clamp(2.5rem, 5vw, 4rem); }
  .reg__glow {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 70% at 8% 0%, rgba(207, 174, 30, 0.13), transparent 62%),
      repeating-linear-gradient(90deg, transparent 0 118px, rgba(232, 230, 225, 0.028) 118px 119px);
    pointer-events: none;
  }

  .reg__inner {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: center;
  }

  .reg__title { font-size: var(--fs-xl); margin-bottom: 1.75rem; }
  .reg__lede { margin-bottom: 2.25rem; }

  /* Numbered route through the page — the same three moves as the form. */
  .reg__steps { list-style: none; padding: 0; display: grid; gap: 0.6rem; }
  .reg__steps li {
    display: flex;
    align-items: baseline;
    gap: 0.85rem;
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--bone-dim);
  }
  .reg__steps b { color: var(--gold); font-weight: 500; }

  /* Film frame. Same recipe as the hero — desaturated and dimmed so the gold
     stays the only chroma. It stops at the page gutter like everything else
     rather than bleeding off the edge. */
  .reg__shot {
    position: relative;
    margin: 0;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px solid rgba(90, 103, 113, 0.32);
    background: var(--navy-deep);
    isolation: isolate;
  }
  .reg__still,
  .reg__video {
    position: absolute;
    inset: 0;
    display: block;
    pointer-events: none;
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.78) contrast(1.06) brightness(0.8);
  }
  /* Held back until the first frame is genuinely playing; the still carries
     the frame until then, so there is no video for a browser to draw a play
     button on. */
  .reg__video { transition: opacity 0.5s ease; }
  .reg__video.is-waiting { opacity: 0; }
  .reg__video::-webkit-media-controls,
  .reg__video::-webkit-media-controls-start-playback-button,
  .reg__video::-webkit-media-controls-panel,
  .reg__video::-webkit-media-controls-overlay-play-button {
    display: none !important;
    -webkit-appearance: none;
    appearance: none;
  }
  .reg__shotScrim {
    position: absolute; inset: 0;
    background: linear-gradient(180deg, rgba(10, 15, 22, 0.1) 0%, transparent 35%, rgba(10, 15, 22, 0.85) 100%);
  }
  .reg__shotLines {
    position: absolute; inset: 0;
    background: repeating-linear-gradient(90deg, transparent 0 78px, rgba(232, 230, 225, 0.05) 78px 79px);
    pointer-events: none;
  }
  .reg__shot figcaption {
    position: absolute;
    left: 1rem; bottom: 0.9rem;
    font-size: 0.58rem;
    letter-spacing: 0.26em;
  }

  /* ═══ FORM ═════════════════════════════════════════════════ */
  .reg__form { display: grid; gap: clamp(2.5rem, 5vw, 4rem); max-width: 1080px; }
  .reg__form.is-sent { display: none; }

  .block { border: 0; padding: 0; margin: 0; }

  /* Section headings, matching the payment section's scale so the form reads
     as the same page. The eyebrow tightens up because the heading, not the
     eyebrow, now carries the space below it. */
  .eyebrow--tight { margin-bottom: 0.9rem; }
  .block__title {
    font-size: clamp(1.9rem, 3.4vw, 2.75rem);
    color: var(--bone);
    margin-bottom: clamp(1.5rem, 3vw, 2.25rem);
  }

  .grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem 1.5rem;
  }
  .field { display: grid; gap: 0.5rem; align-content: start; }
  .field--wide { grid-column: 1 / -1; }
  .field label { line-height: 1.4; }

  input[type='text'],
  input[type='email'],
  input[type='tel'],
  input[type='date'],
  select,
  textarea {
    width: 100%;
    background: var(--navy-deep);
    border: 1px solid rgba(90, 103, 113, 0.45);
    color: var(--bone);
    font-family: var(--font-body);
    font-size: 0.95rem;
    padding: 0.85rem 1rem;
    transition: border-color 0.3s, background 0.3s;
  }
  textarea { resize: vertical; line-height: 1.5; }
  input::placeholder, textarea::placeholder { color: rgba(154, 163, 172, 0.5); }
  input:focus, select:focus, textarea:focus { border-color: var(--gold); outline: none; }
  input[aria-invalid='true'], select[aria-invalid='true'] { border-color: #C9503A; }
  /* The native date picker icon is black-on-black without this. */
  input[type='date']::-webkit-calendar-picker-indicator { filter: invert(0.7); cursor: pointer; }

  .err { color: #E27A66; font-size: 0.8rem; font-family: var(--font-mono); margin-top: 0.6rem; }
  .err[hidden] { display: none; }

  /* --- Program cards -------------------------------------------------
     Radio inputs wearing the same clothes as the home-page program cards:
     the gold frame is the selection, so there's no separate control to read. */
  .picks {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 1.25rem;
  }
  .pick { cursor: pointer; display: grid; }
  .pick input { position: absolute; opacity: 0; width: 0; height: 0; }

  .pick__body {
    display: grid;
    gap: 0.9rem;
    align-content: start;
    height: 100%;
    padding: clamp(1.25rem, 2.5vw, 1.75rem);
    border: 1px solid rgba(90, 103, 113, 0.35);
    background: var(--navy-lift);
    transition: border-color 0.3s, background 0.3s, transform 0.3s;
  }
  .pick:hover .pick__body { border-color: rgba(207, 174, 30, 0.5); transform: translateY(-2px); }
  .pick input:checked + .pick__body { border-color: var(--gold); background: rgba(207, 174, 30, 0.06); }
  .pick input:focus-visible + .pick__body { outline: 2px solid var(--gold); outline-offset: 3px; }

  .pick__top { display: flex; align-items: center; gap: 0.85rem; }
  .pick__index { color: var(--slate); }
  .pick__season { font-size: 0.62rem; }

  /* Ring fills gold on select — the only piece of chrome the card carries. */
  .pick__mark {
    margin-left: auto;
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(90, 103, 113, 0.7);
    display: grid;
    place-items: center;
    transition: border-color 0.25s;
  }
  .pick__mark::after {
    content: '';
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--gold);
    transform: scale(0);
    transition: transform 0.25s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .pick input:checked + .pick__body .pick__mark { border-color: var(--gold); }
  .pick input:checked + .pick__body .pick__mark::after { transform: scale(1); }

  .pick__name { font-size: clamp(1.5rem, 2.6vw, 2rem); color: var(--bone); }
  .pick input:checked + .pick__body .pick__name { color: var(--gold); }

  .pick__specs {
    display: grid;
    gap: 0.35rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--bone-dim);
  }
  .pick__specs b { color: var(--bone); font-weight: 500; }

  .pick__fee {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.35rem;
    padding-top: 0.85rem;
    border-top: 1px solid rgba(90, 103, 113, 0.25);
  }
  .pick__fee b { font-family: var(--font-display); font-size: 1.35rem; color: var(--bone); letter-spacing: 0.02em; }

  /* --- Bundle card -----------------------------------------------------
     Deliberately louder than the two above it: gold frame at rest (they get
     slate), a gold wash, an angled flag, and display type at headline scale.
     It is the only card on the page that looks selected before you touch it,
     which is the point — it reads as the recommendation. */
  .bundle { display: grid; cursor: pointer; margin-top: 1.25rem; position: relative; }
  .bundle input { position: absolute; opacity: 0; width: 0; height: 0; }

  .bundle__body {
    position: relative;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.42fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: center;
    padding: clamp(1.5rem, 3.5vw, 2.5rem);
    border: 1px solid var(--gold-deep);
    background:
      radial-gradient(ellipse 70% 130% at 0% 0%, rgba(207, 174, 30, 0.13), transparent 62%),
      var(--navy-lift);
    transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s;
  }
  .bundle:hover .bundle__body {
    border-color: var(--gold);
    transform: translateY(-2px);
    box-shadow: 0 24px 60px -34px rgba(207, 174, 30, 0.55);
  }
  .bundle input:checked + .bundle__body {
    border-color: var(--gold);
    box-shadow: 0 0 0 1px var(--gold), 0 24px 60px -34px rgba(207, 174, 30, 0.55);
  }
  .bundle input:focus-visible + .bundle__body { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* Angled flag, leaning the same -5deg as the wordmark. */
  .bundle__flag {
    position: absolute;
    top: 0;
    left: clamp(1.5rem, 3.5vw, 2.5rem);
    transform: translateY(-50%) skewX(var(--lean));
    background: var(--gold);
    color: var(--navy-deep);
    font-size: 0.62rem;
    font-weight: 600;
    padding: 0.4rem 0.9rem;
    white-space: nowrap;
  }

  .bundle__main { display: grid; gap: 0.9rem; align-content: start; }
  .bundle__top { display: flex; align-items: center; gap: 1rem; }
  .bundle__kicker { color: var(--gold); }

  .bundle__mark {
    margin-left: auto;
    width: 18px; height: 18px;
    border-radius: 50%;
    border: 1px solid rgba(207, 174, 30, 0.6);
    display: grid;
    place-items: center;
    transition: border-color 0.25s;
  }
  .bundle__mark::after {
    content: '';
    width: 9px; height: 9px;
    border-radius: 50%;
    background: var(--gold);
    transform: scale(0);
    transition: transform 0.25s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .bundle input:checked + .bundle__body .bundle__mark { border-color: var(--gold); }
  .bundle input:checked + .bundle__body .bundle__mark::after { transform: scale(1); }

  /* One step up from the single cards' name, so the hierarchy is unmistakable. */
  .bundle__name { font-size: clamp(1.9rem, 3.6vw, 2.9rem); color: var(--bone); }
  .bundle__blurb { color: var(--bone-dim); font-size: 0.92rem; line-height: 1.55; max-width: 52ch; }

  /* The two rosters, chained by a gold plus. */
  .bundle__chain { display: flex; align-items: stretch; flex-wrap: wrap; gap: 0.65rem; margin-top: 0.35rem; }
  .bundle__chip {
    display: grid;
    gap: 0.15rem;
    padding: 0.6rem 0.9rem;
    border: 1px solid rgba(90, 103, 113, 0.35);
    background: var(--navy-deep);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--bone-dim);
  }
  .bundle__chip b { color: var(--bone); font-weight: 500; font-size: 0.74rem; }
  .bundle__plus { align-self: center; color: var(--gold); font-family: var(--font-mono); }

  /* Price rail, divided off so the arithmetic reads top-to-bottom. */
  .bundle__price {
    display: grid;
    gap: 0.75rem;
    padding-left: clamp(1.5rem, 3vw, 2.5rem);
    border-left: 1px solid rgba(207, 174, 30, 0.28);
  }
  .bundle__priceRow, .bundle__now { display: grid; gap: 0.2rem; }
  .bundle__was { color: var(--slate); font-family: var(--font-mono); font-size: 1rem; }
  .bundle__now b {
    font-family: var(--font-display);
    font-size: clamp(2.25rem, 4.5vw, 3.25rem);
    line-height: 0.9;
    color: var(--gold);
    letter-spacing: 0.02em;
  }
  .bundle__save {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold);
    border-top: 1px solid rgba(207, 174, 30, 0.28);
    padding-top: 0.7rem;
  }
  .bundle__save--tbd { color: #E27A66; line-height: 1.7; }
  .bundle__save--tbd code { color: var(--bone); }

  /* --- Checkboxes --- */
  .checks { display: grid; gap: 1rem; }
  .check { display: flex; align-items: flex-start; gap: 0.75rem; cursor: pointer; font-size: 0.9rem; }
  .check input { position: absolute; opacity: 0; width: 0; height: 0; }
  .check__box {
    width: 17px; height: 17px;
    margin-top: 0.2rem;
    border: 1px solid rgba(90, 103, 113, 0.6);
    flex-shrink: 0;
    display: grid;
    place-items: center;
    transition: background 0.25s, border-color 0.25s;
  }
  .check__box::after {
    content: '';
    width: 8px; height: 8px;
    background: var(--navy-deep);
    transform: scale(0);
    transition: transform 0.25s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .check input:checked + .check__box { background: var(--gold); border-color: var(--gold); }
  .check input:checked + .check__box::after { transform: scale(1); }
  .check input:focus-visible + .check__box { outline: 2px solid var(--gold); outline-offset: 2px; }
  .check__label { color: var(--bone-dim); line-height: 1.5; }
  .check:hover .check__label { color: var(--bone); }
  .check__label em { color: var(--slate); font-style: normal; font-family: var(--font-mono); font-size: 0.75rem; }

  .hp { position: absolute; left: -9999px; opacity: 0; width: 0; height: 0; }

  .submit { display: grid; gap: 0.9rem; justify-items: start; }
  .submit .btn:disabled { opacity: 0.6; cursor: wait; }
  .sendErr {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    line-height: 1.7;
    color: #E27A66;
    border-left: 2px solid #C9503A;
    padding-left: 0.85rem;
    max-width: 52ch;
  }
  .sendErr[hidden] { display: none; }
  .sendErr b { color: var(--bone); font-weight: 500; }
  .submit__fine { font-size: 0.62rem; }

  /* ═══ PAYMENT ══════════════════════════════════════════════ */
  .pay__title { font-size: var(--fs-lg); margin-bottom: clamp(2rem, 4vw, 3rem); }

  .pay__panel {
    display: grid;
    grid-template-columns: minmax(0, 0.85fr) minmax(0, 1.15fr);
    gap: clamp(2rem, 5vw, 4rem);
    border: 1px solid rgba(90, 103, 113, 0.3);
    background: var(--navy-lift);
    padding: clamp(1.75rem, 4vw, 3.5rem);
    transition: border-color 0.5s, box-shadow 0.5s;
  }
  /* Lit once the form has been submitted, so the eye lands here next. */
  .pay__panel.is-live {
    border-color: var(--gold);
    box-shadow: 0 0 0 1px rgba(207, 174, 30, 0.25), 0 24px 60px -30px rgba(207, 174, 30, 0.4);
  }

  .pay__handleBox { display: grid; gap: 0.75rem; align-content: start; }
  .pay__handle { font-size: clamp(2rem, 5vw, 3.25rem); color: var(--gold); word-break: break-all; }
  .pay__handle--empty { color: var(--slate); }
  .pay__warn {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    line-height: 1.7;
    color: #E27A66;
    border-left: 2px solid #C9503A;
    padding-left: 0.85rem;
  }
  .pay__warn code { color: var(--bone); }
  .pay__actions { display: flex; flex-wrap: wrap; gap: 0.75rem; margin-top: 0.5rem; }

  .pay__steps { list-style: none; padding: 0; display: grid; gap: 1.5rem; }
  .pay__steps li { display: grid; grid-template-columns: auto minmax(0, 1fr); gap: 1rem; }
  .pay__n {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--gold);
    padding-top: 0.15rem;
  }
  .pay__steps b { color: var(--bone); font-weight: 500; }
  .pay__steps p { color: var(--bone-dim); font-size: 0.9rem; margin-top: 0.3rem; line-height: 1.55; }
  .pay__amt { font-family: var(--font-mono); color: var(--gold); }
  /* The bundle is the recommendation on the card above, so it stays the
     emphasised line here too rather than reading as a third equal option. */
  .pay__bundleLine { display: inline-flex; align-items: baseline; flex-wrap: wrap; gap: 0.5rem; color: var(--bone); }
  .pay__saveTag {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    background: var(--gold);
    color: var(--navy-deep);
    padding: 0.1rem 0.45rem;
    font-weight: 600;
  }
  .pay__memo {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--bone);
    background: var(--navy-deep);
    border: 1px solid rgba(90, 103, 113, 0.35);
    padding: 0.15rem 0.5rem;
    white-space: nowrap;
  }

  .pay__help { font-size: 0.68rem; margin-top: 2rem; line-height: 1.8; }

  /* Post-submit receipt, swapped in where the form was. */
  .sent {
    display: grid;
    gap: 0.75rem;
    justify-items: start;
    border: 1px solid var(--gold);
    background: rgba(207, 174, 30, 0.06);
    padding: clamp(1.5rem, 4vw, 2.5rem);
  }
  .sent[hidden] { display: none; }
  .sent__mark { font-size: 2.5rem; color: var(--gold); }
  .sent__title { font-size: var(--fs-md); }
  .sent__note { font-size: 0.62rem; }

  @media (max-width: 820px) {
    .bundle__body { grid-template-columns: 1fr; align-items: start; }
    .bundle__price {
      padding-left: 0;
      padding-top: 1.25rem;
      border-left: 0;
      border-top: 1px solid rgba(207, 174, 30, 0.28);
    }
  }

  @media (max-width: 900px) {
    /* Film tucks straight under the nav — the section's top padding would
       otherwise leave a band of empty navy above a full-bleed frame. */
    .reg { padding-top: 0; }
    .reg__inner { grid-template-columns: 1fr; }
    /* Edge to edge above the copy — a 16:9 band is short enough on a phone
       that it opens the page rather than eating the fold. */
    .reg__shot {
      order: -1;
      margin-inline: calc(-1 * var(--gutter));
      border-inline: 0;
    }
    .pay__panel { grid-template-columns: 1fr; }
  }
  @media (max-width: 620px) {
    .grid { grid-template-columns: 1fr; }
    .pay__memo { white-space: normal; }
  }
</style>

<script>
  // Header film: play it, and recover if the browser refused (iOS Low Power
  // Mode is the usual one — the first touch anywhere is gesture enough).
  const regVideo = document.querySelector<HTMLVideoElement>('[data-reg-video]');
  if (regVideo) {
    regVideo.classList.add('is-waiting');
    regVideo.addEventListener('playing', () => regVideo.classList.remove('is-waiting'));

    const kick = () => void regVideo.play().catch(() => {});
    kick();
    regVideo.addEventListener('loadeddata', kick, { once: true });
    document.addEventListener('touchstart', kick, { once: true, passive: true });
    document.addEventListener('click', kick, { once: true });
  }

  const form = document.getElementById('reg-form') as HTMLFormElement | null;
  const panel = document.getElementById('pay-panel');

  // Program cards on the home page link here as /signup?program=<id>, so the
  // parent arrives with their roster already chosen. Matched by comparing
  // values rather than interpolating the param into a selector.
  const wanted = new URLSearchParams(location.search).get('program');
  if (wanted) {
    const radios = form?.querySelectorAll<HTMLInputElement>('input[name="program"]');
    radios?.forEach((r) => { if (r.value === wanted) r.checked = true; });
  }

  const errBox = document.getElementById('reg-error');
  const errDetail = document.getElementById('reg-error-detail');
  const submitBtn = form?.querySelector<HTMLButtonElement>('button[type="submit"]');
  const submitLabel = submitBtn?.querySelector('span');

  /** Locks the button while the request is in flight, so nothing double-sends. */
  const setBusy = (busy: boolean) => {
    if (!submitBtn) return;
    submitBtn.disabled = busy;
    if (submitLabel) submitLabel.textContent = busy ? 'Sending…' : 'Continue to payment';
  };

  const showErr = (key: string, bad: boolean) => {
    const el = form?.querySelector<HTMLElement>(`.err[data-for="${key}"]`);
    if (el) el.hidden = !bad;
  };

  /** Flags the field, reveals its message, and reports whether it passed. */
  const check = (id: string, ok: boolean) => {
    const el = form?.querySelector<HTMLInputElement>(`#${id}`);
    el?.setAttribute('aria-invalid', String(!ok));
    showErr(id, !ok);
    return ok;
  };

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();

    const email = form.querySelector<HTMLInputElement>('#g-email');
    const phone = form.querySelector<HTMLInputElement>('#g-phone');
    const program = form.querySelector<HTMLInputElement>('input[name="program"]:checked');
    const waiver = form.querySelector<HTMLInputElement>('input[name="waiver"]');
    const commitment = form.querySelector<HTMLInputElement>('input[name="commitment"]');

    const agreed = !!waiver?.checked && !!commitment?.checked;

    // Every check runs before the early return so the parent sees all of
    // what's missing at once, rather than one message per attempt.
    const results = [
      check('g-email', /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email?.value ?? '')),
      check('g-phone', (phone?.value ?? '').replace(/\D/g, '').length >= 10),
    ];
    showErr('program', !program);
    showErr('agree', !agreed);

    if (results.includes(false) || !program || !agreed) {
      const firstBad =
        form.querySelector<HTMLElement>('[aria-invalid="true"]') ??
        (!program ? form.querySelector<HTMLElement>('input[name="program"]') : null) ??
        form.querySelector<HTMLElement>('input[name="waiver"]');
      firstBad?.scrollIntoView({ behavior: 'smooth', block: 'center' });
      firstBad?.focus({ preventScroll: true });
      return;
    }

    const endpoint = form.dataset.endpoint;
    if (!endpoint) return;

    const data = Object.fromEntries(new FormData(form)) as Record<string, string>;

    // The radio submits a program id ('summer-travel'); the club's inbox wants
    // the name. Unchecked boxes are absent from FormData, so state them
    // explicitly rather than leaving a consent field silently missing.
    data.program = program.dataset.label ?? program.value;
    for (const key of ['waiver', 'commitment', 'photo']) {
      const box = form.querySelector<HTMLInputElement>(`input[name="${key}"]`);
      data[key] = box?.checked ? 'Yes' : 'No';
    }
    // Makes the notification email scannable without opening it.
    data.subject = `Revolt LC registration — ${data.playerFirst} ${data.playerLast} (${data.program})`;

    setBusy(true);
    if (errBox) errBox.hidden = true;

    try {
      const res = await fetch(endpoint, {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
        body: JSON.stringify(data),
      });
      const body = await res.json().catch(() => ({} as { message?: string; success?: boolean }));
      if (!res.ok || body.success === false) throw new Error(body.message ?? `Error ${res.status}`);
    } catch (err) {
      // Never show the receipt on a failure — the parent would think they were
      // registered when nothing reached the club.
      setBusy(false);
      if (errDetail) errDetail.textContent = err instanceof Error ? err.message : '';
      if (errBox) {
        errBox.hidden = false;
        errBox.scrollIntoView({ behavior: 'smooth', block: 'center' });
      }
      return;
    }

    // Swap the form for the receipt, then send the parent to the Venmo panel.
    form.classList.add('is-sent');
    const receipt = document.getElementById('reg-sent');
    if (receipt) receipt.hidden = false;

    panel?.classList.add('is-live');
    panel?.scrollIntoView({ behavior: 'smooth', block: 'start' });
  });

  document.getElementById('copy-handle')?.addEventListener('click', async (e) => {
    const btn = e.currentTarget as HTMLButtonElement;
    const span = btn.querySelector('span');
    if (!span) return;
    try {
      await navigator.clipboard.writeText(btn.dataset.handle ?? '');
      span.textContent = 'Copied';
      setTimeout(() => { span.textContent = 'Copy handle'; }, 1800);
    } catch {
      span.textContent = 'Copy failed';
      setTimeout(() => { span.textContent = 'Copy handle'; }, 1800);
    }
  });
</script>
