---
/**
 * REVOLT LC — GALLERY
 *
 * Every photo in the club's set, in one masonry column layout with a lightbox.
 *
 * The lightbox reuses each thumbnail's own srcset rather than generating a
 * second, larger copy of all 238 images: the grid asks for a small `sizes`, the
 * lightbox re-declares it as 92vw, and the browser picks the big variant out of
 * the srcset it already has. That halves the number of build transforms and
 * means the lightbox image is often already in cache.
 */
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import { photos, photoCount, seasonLabel, altFor } from '../data/gallery';
---

<Layout
  title="Photo Gallery — Revolt Lacrosse Club"
  description={`${photoCount} photos of Revolt LC teams from the ${seasonLabel} season — game action, sidelines and squads in the black and gold.`}
>
  <!-- ═══ HEADER ═══════════════════════════════════════════════ -->
  <section class="gHero">
    <div class="gHero__bg" aria-hidden="true"></div>
    <div class="shell gHero__inner">
      <div class="eyebrow">
        <span class="label">[ Gallery ]</span>
        <span class="eyebrow__rule"></span>
        <span class="label label--dim">{seasonLabel}</span>
      </div>

      <h1 class="gHero__title display">
        Every roster<br />
        <span class="display--ghost">that wore</span><br />
        <span class="display--gold">the black and gold.</span>
      </h1>

      <div class="gHero__foot">
        <p class="lede">
          The full set — game action, sidelines and squads. Click any photo to open
          it full size, then use the arrow keys to move through them.
        </p>
        <dl class="gHero__stats">
          <div><dt class="label label--dim">Photos</dt><dd class="display">{photoCount}</dd></div>
          <div><dt class="label label--dim">Season</dt><dd class="display">{seasonLabel}</dd></div>
        </dl>
      </div>
    </div>
  </section>

  <!-- ═══ GRID ═════════════════════════════════════════════════
       CSS multi-column, not a fixed grid: the set mixes portrait and
       landscape, and columns let every photo keep its own shape. -->
  <section class="section gWrap">
    <div class="shell">
      <div class="gGrid" id="grid">
        {photos.map((p, i) => (
          <button class="cell" type="button" data-i={i} aria-label={`Open photo ${i + 1} of ${photoCount}`}>
            <Image
              src={p.src}
              alt={altFor(i)}
              widths={[400, 800, 1400]}
              /* Caps the fallback at the largest width asked for. Without it
                 Astro makes the untouched 2400px original the src, which is
                 both a wasted transform and a huge file to hand a browser. */
              width={Math.min(1400, p.src.width)}
              height={Math.round(p.src.height * (Math.min(1400, p.src.width) / p.src.width))}
              sizes="(max-width: 700px) 50vw, (max-width: 1200px) 33vw, 320px"
              quality={78}
              loading="lazy"
            />
            <span class="cell__veil" aria-hidden="true"></span>
          </button>
        ))}
      </div>
    </div>
  </section>

  <!-- ═══ LIGHTBOX ═════════════════════════════════════════════ -->
  <div class="lb" id="lb" hidden role="dialog" aria-modal="true" aria-label="Photo viewer">
    <button class="lb__x" id="lb-close" aria-label="Close viewer">&times;</button>
    <button class="lb__nav lb__nav--prev" id="lb-prev" aria-label="Previous photo">&#8592;</button>
    <button class="lb__nav lb__nav--next" id="lb-next" aria-label="Next photo">&#8594;</button>

    <figure class="lb__fig">
      <img id="lb-img" alt="" sizes="92vw" decoding="async" />
      <figcaption class="lb__cap label label--dim">
        <span id="lb-count"></span>
        <span class="lb__hint">Arrow keys to move · Esc to close</span>
      </figcaption>
    </figure>
  </div>
</Layout>

<style>
  /* ═══ HEADER ═══ */
  .gHero { position: relative; overflow: hidden; padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(2rem, 4vw, 3rem); }
  .gHero__bg {
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 55% 75% at 10% 0%, rgba(207, 174, 30, 0.13), transparent 62%),
      repeating-linear-gradient(90deg, transparent 0 118px, rgba(232, 230, 225, 0.028) 118px 119px);
    pointer-events: none;
  }
  .gHero__inner { position: relative; }
  .gHero__title { font-size: var(--fs-xl); margin-bottom: 2rem; }
  .gHero__foot {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2.5rem;
    flex-wrap: wrap;
  }
  .gHero__stats { display: flex; gap: clamp(1.5rem, 4vw, 3rem); margin: 0; }
  .gHero__stats dt { margin-bottom: 0.35rem; }
  .gHero__stats dd { margin: 0; font-size: clamp(1.75rem, 3.5vw, 2.5rem); color: var(--gold); }

  /* ═══ GRID ═══ */
  .gWrap { padding-top: clamp(2rem, 4vw, 3rem); }
  .gGrid { columns: 4 300px; column-gap: clamp(0.6rem, 1.2vw, 1rem); }

  .cell {
    position: relative;
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 clamp(0.6rem, 1.2vw, 1rem);
    /* Keeps a photo from being split across two columns. */
    break-inside: avoid;
    border: 1px solid rgba(90, 103, 113, 0.22);
    background: var(--navy-lift);
    overflow: hidden;
    cursor: zoom-in;
    transition: border-color 0.3s;
  }
  .cell :global(img) {
    width: 100%;
    height: auto;
    display: block;
    filter: saturate(0.74) contrast(1.05) brightness(0.8);
    transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1), filter 0.4s;
  }
  .cell__veil {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 60%, rgba(10, 15, 22, 0.5) 100%);
    opacity: 1;
    transition: opacity 0.4s;
    pointer-events: none;
  }
  .cell:hover { border-color: var(--gold); }
  .cell:hover :global(img) { transform: scale(1.04); filter: saturate(1) contrast(1) brightness(1); }
  .cell:hover .cell__veil { opacity: 0; }
  .cell:focus-visible { outline: 2px solid var(--gold); outline-offset: 3px; }

  /* ═══ LIGHTBOX ═══ */
  .lb {
    position: fixed;
    inset: 0;
    z-index: 200;
    background: rgba(6, 9, 14, 0.96);
    backdrop-filter: blur(8px);
    display: grid;
    place-items: center;
    padding: clamp(1rem, 4vw, 3rem);
  }
  .lb[hidden] { display: none; }

  .lb__fig { margin: 0; display: grid; gap: 0.9rem; justify-items: center; max-height: 100%; }
  .lb__fig img {
    max-width: min(92vw, 1600px);
    max-height: 80vh;
    width: auto;
    height: auto;
    object-fit: contain;
    border: 1px solid rgba(90, 103, 113, 0.35);
  }
  .lb__cap { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: center; font-size: 0.62rem; }
  .lb__hint { color: var(--slate); }

  .lb__x {
    position: absolute;
    top: clamp(0.75rem, 2vw, 1.5rem);
    right: clamp(0.75rem, 2vw, 1.5rem);
    font-size: 2rem;
    line-height: 1;
    width: 44px;
    height: 44px;
    color: var(--bone-dim);
    transition: color 0.25s;
  }
  .lb__x:hover { color: var(--gold); }

  .lb__nav {
    position: absolute;
    top: 50%;
    transform: translateY(-50%);
    width: 52px;
    height: 52px;
    font-size: 1.35rem;
    color: var(--bone-dim);
    border: 1px solid rgba(90, 103, 113, 0.4);
    background: rgba(10, 15, 22, 0.6);
    transition: color 0.25s, border-color 0.25s;
  }
  .lb__nav:hover { color: var(--gold); border-color: var(--gold); }
  .lb__nav--prev { left: clamp(0.5rem, 2vw, 2rem); }
  .lb__nav--next { right: clamp(0.5rem, 2vw, 2rem); }

  @media (max-width: 700px) {
    .gGrid { columns: 2 140px; }
    .lb__nav { top: auto; bottom: 1rem; transform: none; }
    .lb__fig img { max-height: 68vh; }
  }
</style>

<script>
  const grid = document.getElementById('grid');
  const lb = document.getElementById('lb');
  const lbImg = document.getElementById('lb-img') as HTMLImageElement | null;
  const lbCount = document.getElementById('lb-count');
  const cells = Array.from(grid?.querySelectorAll<HTMLButtonElement>('.cell') ?? []);

  let index = -1;
  let lastFocus: HTMLElement | null = null;

  const show = (i: number) => {
    // Wrap at both ends so the arrows never dead-end.
    index = (i + cells.length) % cells.length;
    const thumb = cells[index]?.querySelector('img');
    if (!thumb || !lbImg) return;

    // Reuse the thumbnail's srcset — with sizes at 92vw the browser resolves it
    // to the largest variant, so no second set of images has to be generated.
    lbImg.srcset = thumb.srcset;
    lbImg.src = thumb.src;
    lbImg.alt = thumb.alt;
    if (lbCount) lbCount.textContent = `${index + 1} / ${cells.length}`;
  };

  const open = (i: number) => {
    lastFocus = document.activeElement as HTMLElement;
    show(i);
    if (lb) lb.hidden = false;
    document.body.style.overflow = 'hidden';
    document.getElementById('lb-close')?.focus();
  };

  const close = () => {
    if (lb) lb.hidden = true;
    document.body.style.overflow = '';
    // Send focus back to the photo they opened, not the top of the page.
    lastFocus?.focus();
  };

  cells.forEach((c, i) => c.addEventListener('click', () => open(i)));

  document.getElementById('lb-close')?.addEventListener('click', close);
  document.getElementById('lb-prev')?.addEventListener('click', () => show(index - 1));
  document.getElementById('lb-next')?.addEventListener('click', () => show(index + 1));

  // Clicking the backdrop closes; clicking the photo itself does not.
  lb?.addEventListener('click', (e) => { if (e.target === lb) close(); });

  document.addEventListener('keydown', (e) => {
    if (lb?.hidden) return;
    if (e.key === 'Escape') close();
    else if (e.key === 'ArrowLeft') show(index - 1);
    else if (e.key === 'ArrowRight') show(index + 1);
  });
</script>
