---
/**
 * HOME — PHOTO STRIP
 *
 * Three photos, picked at random from the curated pool in data/gallery.ts, and
 * a way through to the full gallery. The picks are made at build time, so the
 * trio changes on every deploy rather than on every page load — see the note on
 * pickRandom().
 *
 * The tiles are forced to one portrait ratio: the source set mixes portrait and
 * landscape, and three different shapes in a row reads as a broken grid rather
 * than as a deliberate one.
 */
import { Image } from 'astro:assets';
import { pickRandom, photoCount, seasonLabel } from '../data/gallery';

const picks = pickRandom(3);
---

<section class="section shots" id="photos">
  <div class="shell">
    <header class="shots__head reveal">
      <div>
        <div class="eyebrow">
          <span class="label">[ 004 ]</span>
          <span class="eyebrow__rule"></span>
          <span class="label label--dim">Revolt Photos</span>
        </div>

        <h2 class="display shots__title">
          Past teams.<br /><span class="display--gold">Same crest.</span>
        </h2>

        <p class="lede">
          Every roster that has worn the black and gold, on the field where it was
          earned. {photoCount} photos from the {seasonLabel} season.
        </p>
      </div>

      <a href="/gallery" class="btn btn--gold shots__cta">
        <span>See our success</span><span class="btn__arrow">→</span>
      </a>
    </header>

    <div class="shots__grid reveal">
      {picks.map((p, i) => (
        <a href="/gallery" class="shot" style={`--d:${i * 90}ms`}>
          <Image
            src={p.src}
            alt={`Revolt LC players in black and gold during the ${seasonLabel} season`}
            widths={[420, 640, 900]}
            width={900}
            height={1125}
            sizes="(max-width: 760px) 100vw, 33vw"
            quality={80}
            loading="lazy"
          />
          <span class="shot__scrim" aria-hidden="true"></span>
          <span class="shot__no label" aria-hidden="true">
            {String(i + 1).padStart(2, '0')}
          </span>
        </a>
      ))}
    </div>

    <p class="shots__foot label label--dim reveal">
      <a href="/gallery" class="clink">Open the full gallery</a> — all {photoCount} photos.
    </p>
  </div>
</section>

<style>
  .shots__head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    flex-wrap: wrap;
    margin-bottom: clamp(2rem, 4vw, 3rem);
  }
  .shots__title { font-size: var(--fs-lg); margin-bottom: 1.25rem; }
  .shots__cta { flex-shrink: 0; }

  .shots__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(0.6rem, 1.5vw, 1.1rem);
  }

  .shot {
    position: relative;
    display: block;
    /* One ratio for all three: the source mixes portrait and landscape. */
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border: 1px solid rgba(90, 103, 113, 0.28);
    background: var(--navy-lift);
    transition: border-color 0.35s;
  }
  .shot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    /* Same recipe as the hero — the gold pinnies stay the only chroma until
       you hover, then the photo comes up to full colour. */
    filter: saturate(0.72) contrast(1.06) brightness(0.76);
    transform: scale(1.02);
    transition: transform 0.7s cubic-bezier(0.22, 1, 0.36, 1), filter 0.5s;
  }
  .shot:hover { border-color: var(--gold); }
  .shot:hover :global(img) { transform: scale(1.06); filter: saturate(1) contrast(1.02) brightness(0.95); }

  .shot__scrim {
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(10, 15, 22, 0.8) 100%);
    pointer-events: none;
  }
  .shot__no {
    position: absolute;
    left: 0.85rem;
    bottom: 0.7rem;
    font-size: 0.62rem;
    color: var(--gold);
  }

  /* Staggered reveal, so the three land as a sequence rather than a block. */
  :global(.js) .reveal .shot { transition-delay: var(--d); }

  .shots__foot { font-size: 0.68rem; margin-top: 1.5rem; }

  @media (max-width: 760px) {
    .shots__grid { grid-template-columns: 1fr 1fr; }
    /* Third tile spans the pair below rather than leaving a hole. */
    .shot:last-child { grid-column: 1 / -1; aspect-ratio: 16 / 10; }
    .shots__cta { width: 100%; justify-content: center; }
  }
</style>
