---
const links = [
  { label: 'Programs', href: '/#programs' },
  { label: 'Why Revolt', href: '/why' },
  { label: 'Coaches', href: '/#coaches' },
  { label: 'Alumni', href: '/#alumni' },
  { label: 'Photos', href: '/gallery' },
  { label: 'Register', href: '/signup' },
];
---

<header class="nav" id="nav">
  <div class="nav__inner">
    <a href="/" class="nav__brand" aria-label="Revolt Lacrosse Club — home">
      <img src="/revolt-mark.png" alt="" class="nav__mark" width="44" height="44" />
      <span class="nav__word display">Revolt</span>
      <span class="nav__sub label label--dim">Lacrosse Club</span>
    </a>

    <nav class="nav__links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href} class="nav__link">
          <span>{l.label}</span>
        </a>
      ))}
    </nav>

    <a href="/signup" class="nav__cta btn btn--gold">
      <span>Register</span>
    </a>

    <button class="nav__toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span>
    </button>
  </div>

  <div class="nav__mobile" id="nav-mobile" hidden>
    {links.map((l) => (
      <a href={l.href} class="nav__mlink display">{l.label}</a>
    ))}
    <a href="/signup" class="btn btn--gold nav__mcta"><span>Register</span></a>
  </div>
</header>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 100;
    background: rgba(10, 15, 22, 0.82);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid rgba(90, 103, 113, 0.2);
  }

  .nav__inner {
    max-width: var(--maxw);
    margin-inline: auto;
    padding: 0.85rem var(--gutter);
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  /* --- Brand lockup --- */
  .nav__brand {
    display: grid;
    grid-template-columns: auto auto;
    grid-template-rows: auto auto;
    align-items: center;
    column-gap: 0.7rem;
    margin-right: auto;
  }
  .nav__mark {
    grid-row: 1 / 3;
    width: 40px;
    height: 40px;
    object-fit: contain;
  }
  .nav__word {
    font-size: 1.5rem;
    color: var(--bone);
    line-height: 1;
    align-self: end;
  }
  .nav__sub {
    font-size: 0.55rem;
    letter-spacing: 0.3em;
    align-self: start;
    padding-top: 0.2rem;
  }

  /* --- Links: gold underline wipes in --- */
  .nav__links { display: flex; gap: 2.2rem; }
  .nav__link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--bone-dim);
    position: relative;
    padding-block: 0.4rem;
    transition: color 0.3s;
  }
  .nav__link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 0;
    height: 1px;
    width: 100%;
    background: var(--gold);
    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .nav__link:hover { color: var(--bone); }
  .nav__link:hover::after { transform: scaleX(1); transform-origin: left; }

  .nav__cta { padding: 0.7rem 1.25rem; font-size: 0.65rem; }

  /* --- Mobile --- */
  .nav__toggle {
    display: none;
    flex-direction: column;
    gap: 5px;
    padding: 0.6rem 0.2rem;
  }
  .nav__toggle span {
    width: 24px;
    height: 2px;
    background: var(--bone);
    transition: transform 0.3s, opacity 0.3s;
  }
  .nav__toggle[aria-expanded='true'] span:first-child { transform: translateY(3.5px) rotate(45deg); }
  .nav__toggle[aria-expanded='true'] span:last-child  { transform: translateY(-3.5px) rotate(-45deg); }

  .nav__mobile {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    padding: 1.25rem var(--gutter) 2rem;
    border-top: 1px solid rgba(90, 103, 113, 0.2);
  }
  .nav__mobile[hidden] { display: none; }
  .nav__mlink {
    font-size: 2rem;
    color: var(--bone);
    padding-block: 0.35rem;
    transition: color 0.25s;
  }
  .nav__mlink:hover { color: var(--gold); }
  .nav__mcta { margin-top: 1rem; align-self: flex-start; }

  @media (max-width: 900px) {
    .nav__links, .nav__cta { display: none; }
    .nav__toggle { display: flex; }
    .nav__sub { display: none; }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav__toggle');
  const panel = document.getElementById('nav-mobile');

  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!open));
    if (panel) panel.hidden = open;
  });

  // Close the panel after tapping a link (same-page anchors don't reload).
  panel?.querySelectorAll('a').forEach((a) =>
    a.addEventListener('click', () => {
      toggle?.setAttribute('aria-expanded', 'false');
      if (panel) panel.hidden = true;
    })
  );
</script>
