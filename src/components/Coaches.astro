---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';
import { coaches, coachingSince } from '../data/coaches';
import CollegeLink from './CollegeLink.astro';

import mitch1 from '../assets/coaches/mitch-1.png';
import mitch2 from '../assets/coaches/mitch-2.jpg';
import mitch3 from '../assets/coaches/mitch-3.jpg';
import mitch4 from '../assets/coaches/mitch-4.jpg';
import sam1 from '../assets/coaches/sam-1.jpg';
import sam2 from '../assets/coaches/sam-2.jpg';

/**
 * Photos for the click-through in an open roster row, in the order the club
 * supplied them (Mitch 1-4, Sam 1-2). Keyed by name: a coach without an entry
 * simply opens to their record, exactly as before.
 */
const shots: Record<string, { src: ImageMetadata; alt: string }[]> = {
  'Mitchell Wilkins': [
    { src: mitch1, alt: 'Mitchell Wilkins, headshot' },
    { src: mitch2, alt: 'Mitchell Wilkins talking with his players during a break in play' },
    { src: mitch3, alt: 'Mitchell Wilkins on the field with Revolt players in gold pinnies' },
    { src: mitch4, alt: 'Mitchell Wilkins on the sideline in Edgewood lacrosse gear' },
  ],
  'Sam Anderson': [
    { src: sam1, alt: 'Sam Anderson in his Indiana Tech jersey, walking off the field' },
    { src: sam2, alt: 'Sam Anderson carrying the ball upfield in a Warriors uniform' },
  ],
};
---

<section class="section coaches" id="coaches">
  <div class="shell">
    <header class="coaches__head reveal">
      <div class="eyebrow">
        <span class="label">[ 002 ]</span>
        <span class="eyebrow__rule"></span>
        <span class="label label--dim">Coaching Staff</span>
      </div>

      <div class="coaches__intro">
        <h2 class="display coaches__title">
          <span class="coaches__line">From college to high school,</span>
          <span class="coaches__line display--gold">we’ve got it covered.</span>
        </h2>
      </div>
    </header>

    <!-- Accordion roster: rows expand on hover/focus. Reads as a list, opens as a record. -->
    <ul class="roster reveal">
      {coaches.map((c) => {
        const photos = shots[c.name] ?? [];
        return (
        <li class="roster__row">
          <button class="roster__btn" aria-expanded="false">
            <span class="roster__idx label label--dim">{c.index}</span>
            <span class="roster__name display">{c.name}</span>
            <span class="roster__role">{c.role}</span>
            <span class="roster__since label label--dim">Since {coachingSince(c)}</span>
            <span class="roster__plus" aria-hidden="true"></span>
          </button>

          <div class="roster__panel">
            <div class="roster__panelInner">
              <div class:list={['roster__grid', photos.length > 0 && 'roster__grid--shots']}>

              {photos.length > 0 && (
                <figure class="shots" data-shots>
                  <button
                    class="shots__stage"
                    data-shots-stage
                    aria-label={`Next photo — 1 of ${photos.length}`}
                  >
                    {photos.map((ph, i) => (
                      <Image
                        src={ph.src}
                        alt={ph.alt}
                        class:list={['shots__img', i === 0 && 'is-on']}
                        aria-hidden={i === 0 ? undefined : 'true'}
                        widths={[320, 480, 680]}
                        sizes="(max-width: 860px) 92vw, 340px"
                        quality={80}
                        loading="lazy"
                      />
                    ))}
                    <span class="shots__next" aria-hidden="true">→</span>
                  </button>

                  <figcaption class="shots__meta">
                    <span class="shots__dots" aria-hidden="true">
                      {photos.map((_, i) => <i class:list={['shots__dot', i === 0 && 'is-on']}></i>)}
                    </span>
                    <span class="shots__count label label--dim">
                      <span data-shots-num>01</span> / {String(photos.length).padStart(2, '0')}
                    </span>
                  </figcaption>
                </figure>
              )}

              <div class="roster__body">
                <span class="label label--dim">Coaching history</span>
                <ol class="track">
                  {c.history.map((h) => (
                    <li class={h.to === null ? 'track__item track__item--now' : 'track__item'}>
                      <span class="track__when label label--dim">
                        {h.from}–{h.to === null ? 'Present' : h.to}
                      </span>
                      <CollegeLink name={h.org} class="track__org" />
                      <span class="track__title">{h.title}</span>
                    </li>
                  ))}
                </ol>
              </div>

              </div>
            </div>
          </div>
        </li>
        );
      })}
    </ul>
  </div>
</section>

<style>
  .coaches__intro { margin-bottom: clamp(3rem, 6vw, 4.5rem); }
  .coaches__title {
    font-size: var(--fs-xl);
    display: flex;
    flex-direction: column;
  }
  /* Second line steps in, the same stagger the hero headline uses. */
  .coaches__line:nth-child(2) { padding-left: clamp(1rem, 5vw, 5rem); }

  .roster { list-style: none; padding: 0; border-top: 1px solid rgba(90, 103, 113, 0.28); }
  .roster__row { border-bottom: 1px solid rgba(90, 103, 113, 0.28); }

  .roster__btn {
    width: 100%;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.5fr) minmax(0, 1fr) 6.5rem 1.5rem;
    align-items: center;
    gap: clamp(0.75rem, 2vw, 2rem);
    padding-block: clamp(1.1rem, 2.2vw, 1.6rem);
    text-align: left;
    transition: padding-inline 0.4s ease, background 0.4s;
  }
  .roster__btn:hover,
  .roster__btn[aria-expanded='true'] {
    padding-inline: clamp(0.5rem, 1.5vw, 1.25rem);
    background: linear-gradient(90deg, rgba(207, 174, 30, 0.07), transparent 60%);
  }

  .roster__name {
    font-size: clamp(1.3rem, 2.6vw, 2.1rem);
    transition: color 0.35s;
  }
  .roster__btn:hover .roster__name,
  .roster__btn[aria-expanded='true'] .roster__name { color: var(--gold); }

  .roster__role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.08em;
    color: var(--bone-dim);
  }
  .roster__since { justify-self: end; white-space: nowrap; }

  /* Plus → minus */
  .roster__plus {
    position: relative;
    width: 14px;
    height: 14px;
    justify-self: end;
  }
  .roster__plus::before,
  .roster__plus::after {
    content: '';
    position: absolute;
    background: var(--gold);
    transition: transform 0.35s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .roster__plus::before { inset: 6px 0; height: 2px; }
  .roster__plus::after  { inset: 0 6px; width: 2px; }
  .roster__btn[aria-expanded='true'] .roster__plus::after { transform: rotate(90deg); }

  /* Panel uses grid-template-rows so it animates without a fixed height */
  .roster__panel {
    display: grid;
    grid-template-rows: 0fr;
    transition: grid-template-rows 0.45s cubic-bezier(0.65, 0, 0.35, 1);
  }
  .roster__row.is-open .roster__panel { grid-template-rows: 1fr; }
  .roster__panelInner { overflow: hidden; }

  /* The padding lives on the wrapper now so the photo column shares it. */
  .roster__grid {
    padding-left: clamp(0.5rem, 4vw, 4rem);
    padding-top: 0.25rem;
    padding-bottom: 2.25rem;
  }
  /* Photos on the left, the record beside them. Rows without photos are
     untouched — the wrapper stays a plain block. */
  .roster__grid--shots {
    display: grid;
    grid-template-columns: clamp(230px, 25vw, 340px) minmax(0, 1fr);
    gap: clamp(1.5rem, 4vw, 3rem);
    align-items: start;
  }

  /* --- Click-through: the whole frame is the button, one photo per click. --- */
  .shots { margin: 0; }
  .shots__stage {
    display: grid;
    width: 100%;
    aspect-ratio: 5 / 4;      /* every supplied photo is 5:4 */
    padding: 0;
    position: relative;
    overflow: hidden;
    border: 1px solid rgba(90, 103, 113, 0.35);
    background: var(--navy-lift);
    cursor: pointer;
    transition: border-color 0.35s ease;
  }
  .shots__stage:hover { border-color: var(--gold); }

  .shots__img {
    grid-area: 1 / 1;         /* every frame in the same cell */
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0;
    transform: scale(1.02);
    transition: opacity 0.45s ease, transform 0.6s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shots__img.is-on { opacity: 1; transform: none; }

  /* Affordance: it has to look clickable before anyone clicks it. */
  .shots__next {
    position: absolute;
    right: 0;
    bottom: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    width: 2.4rem;
    height: 2.4rem;
    background: var(--gold);
    color: var(--navy-deep);
    font-family: var(--font-mono);
    font-size: 0.95rem;
    transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .shots__stage:hover .shots__next { transform: translateX(3px); }

  .shots__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.7rem;
  }
  .shots__dots { display: flex; gap: 5px; }
  .shots__dot {
    width: 13px;
    height: 2px;
    background: rgba(90, 103, 113, 0.5);
    transition: width 0.4s cubic-bezier(0.22, 1, 0.36, 1), background 0.4s ease;
  }
  .shots__dot.is-on { width: 26px; background: var(--gold); }
  .shots__count { white-space: nowrap; }

  /* --- Appointment track: same spine language as the program calendar. --- */
  .track {
    list-style: none;
    padding: 0;
    margin-top: 1.1rem;
    display: grid;
    gap: 1.4rem;
  }
  .track__item {
    position: relative;
    padding-left: 1.75rem;
  }
  /* Hollow marker for a closed appointment, filled gold for a current one. */
  .track__item::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.3em;
    width: 7px;
    height: 7px;
    border: 1px solid var(--slate);
  }
  .track__item--now::before {
    background: var(--gold);
    border-color: var(--gold);
  }
  /* Connector between markers */
  .track__item::after {
    content: '';
    position: absolute;
    left: 3px;
    top: calc(0.3em + 10px);
    bottom: -1.4rem;
    width: 1px;
    background: rgba(90, 103, 113, 0.35);
  }
  .track__item:last-child::after { display: none; }

  .track__when { display: block; }
  .track__org {
    display: block;
    font-family: var(--font-display);
    font-size: 1.15rem;
    text-transform: uppercase;
    letter-spacing: 0.01em;
    line-height: 1.15;
    margin-top: 0.2rem;
  }
  .track__item--now .track__org { color: var(--gold); }
  .track__title {
    display: block;
    color: var(--bone-dim);
    font-size: 0.92rem;
  }

  @media (max-width: 860px) {
    /* Photo above the record — 230px of photo plus a résumé is too narrow. */
    .roster__grid--shots {
      grid-template-columns: minmax(0, 1fr);
      gap: 1.5rem;
    }
    .shots { max-width: 420px; }

    .roster__btn {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.25rem;
      row-gap: 0.2rem;
    }
    /* Every cell needs an explicit slot here: .roster__plus spans two rows, and
       a definite-row item with an auto column gets placed before the auto-flow
       items — which lands it in column 1 and pushes the name off-screen. */
    .roster__idx   { grid-column: 1; grid-row: 1; }
    .roster__name  { grid-column: 2; grid-row: 1; }
    .roster__role  { grid-column: 2; grid-row: 2; }
    .roster__plus  { grid-column: 3; grid-row: 1 / 3; }
    .roster__since { display: none; }
  }
</style>

<script>
  // Photo click-through: click the frame, get the next one, wrap at the end.
  document.querySelectorAll<HTMLElement>('[data-shots]').forEach((fig) => {
    const stage = fig.querySelector<HTMLButtonElement>('[data-shots-stage]');
    const imgs = [...fig.querySelectorAll<HTMLElement>('.shots__img')];
    const dots = [...fig.querySelectorAll<HTMLElement>('.shots__dot')];
    const num = fig.querySelector<HTMLElement>('[data-shots-num]');
    if (!stage || imgs.length < 2) return;

    let i = 0;
    const show = (n: number) => {
      i = (n + imgs.length) % imgs.length;
      imgs.forEach((img, k) => {
        img.classList.toggle('is-on', k === i);
        // Only the visible frame should reach a screen reader.
        if (k === i) img.removeAttribute('aria-hidden');
        else img.setAttribute('aria-hidden', 'true');
      });
      dots.forEach((dot, k) => dot.classList.toggle('is-on', k === i));
      if (num) num.textContent = String(i + 1).padStart(2, '0');
      stage.setAttribute('aria-label', `Next photo — ${i + 1} of ${imgs.length}`);
    };

    stage.addEventListener('click', () => show(i + 1));
  });

  document.querySelectorAll<HTMLButtonElement>('.roster__btn').forEach((btn) => {
    btn.addEventListener('click', () => {
      const row = btn.closest('.roster__row');
      const open = btn.getAttribute('aria-expanded') === 'true';
      btn.setAttribute('aria-expanded', String(!open));
      row?.classList.toggle('is-open', !open);
    });
  });
</script>
